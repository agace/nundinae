PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=nundinae
DB_PASSWORD=nundinae_dev
DB_NAME=nundinae

JWT_SECRET=change-me-in-production-nundinae-secret
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Mercado Pago — usado pelo PIX REAL (Checkout Transparente).
# Para receber PIX de verdade, use o Access Token de PRODUÇÃO da sua conta
# (Suas integrações > app > Credenciais de produção) e tenha uma chave PIX
# cadastrada na conta. Sem o token, o PIX cai no modo simulado.
# Cartão e boleto são sempre simulados (ambiente acadêmico).
MP_ACCESS_TOKEN=

# E-mail (SMTP). Ex. Gmail: host smtp.gmail.com, port 587, user e-mail, pass app password.
# Ex. Resend: host smtp.resend.com, port 587, user "resend", pass = API key.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nundinae <no-reply@nundinae.com>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
