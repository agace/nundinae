PORT=4000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=nundinae
DB_PASSWORD=nundinae_dev
DB_NAME=nundinae
# Bancos gerenciados (Aiven, RDS) exigem TLS: use DB_SSL=true.
DB_SSL=false
# Certificado da CA do provedor, quando ele assina com CA própria (Aiven).
# Cole o conteúdo do ca.pem, ou o mesmo conteúdo em base64.
DB_SSL_CA=

# Obrigatório em produção: mínimo de 32 caracteres, aleatório e secreto.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origens permitidas no CORS, separadas por vírgula.
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Mercado Pago: habilita o PIX real (Checkout Transparente). Sem o token, o PIX
# cai no modo simulado. Cartão e boleto são sempre simulados (projeto acadêmico).
MP_ACCESS_TOKEN=

# E-mail pela API HTTP do Resend (porta 443, não depende de portas SMTP).
# Sem domínio verificado, use "Nundinae <onboarding@resend.dev>", que só envia
# para o e-mail dono da conta Resend.
RESEND_API_KEY=
RESEND_FROM=Nundinae <onboarding@resend.dev>

# Cloudinary: sem as três chaves, o upload cai no fallback base64 no banco.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
